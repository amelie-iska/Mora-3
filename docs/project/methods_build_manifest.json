{"book_redistributed":false,"empirical_tables":5,"empirical_values_populated":false,"empty_charts":4,"figures":["architecture","topology","refinement","directed","topology-metrics","campaign"],"formal_claims":12,"math_equations":[{"height_pt":37.733,"number":1,"path":"equation-01.svg","source":"\\pi_\\theta(a\\mid c,s)=\\frac{\\exp \\ell_\\theta(c,s,a)}{\\sum_{b\\in A(s)}\\exp \\ell_\\theta(c,s,b)},\\qquad a\\in A(s).","source_sha256":"be07ddcd55d38909eff372e39968658d613c83823d7b19abb6e1c4738d7e3073","width_pt":229.923},{"height_pt":46.365,"number":2,"path":"equation-02.svg","source":"p_\\theta(T\\mid c)=\\prod_{j=0}^{2|T|-R-1}\\pi_\\theta(a_j\\mid c,s_j),\\qquad \\sum_{T\\in\\mathcal T_{M,D,C,R}}p_\\theta(T\\mid c)=1.","source_sha256":"a472f1b66a7e8ffe8a5370ca27d5ff44fc1397be296de1e062a1af193d717e29","width_pt":283.773},{"height_pt":43.149,"number":3,"path":"equation-03.svg","source":"\\mathcal L_{\\mathrm{top}}=-\\frac{1}{B}\\sum_{b=1}^{B}\\log p_\\theta(T_b\\mid c_b).","source_sha256":"eaae8d47229ced18f9a93b51fd6cd5ca63e2c3fc353a79b0c0b94eb423041864","width_pt":140.993},{"height_pt":21.918,"number":4,"path":"equation-04.svg","source":"X_t=tY+[1-(1-\\sigma)t]\\varepsilon,\\qquad U_t=Y-(1-\\sigma)\\varepsilon,\\qquad \\varepsilon\\sim\\mathcal N(0,I),\\quad t\\sim\\mathcal U[0,1].","source_sha256":"3febe712ad7752a8749138f50da091d1a4a59fa778f5ccc809e8307188381266","width_pt":361.921},{"height_pt":38.417,"number":5,"path":"equation-05.svg","source":"\\sum_T\\int_{\\mathbb R^{d_T}}p(T\\mid c)q(z\\mid T,c)\\,dz=\\sum_T p(T\\mid c)=1.","source_sha256":"0a07969a9bb4b8990c3f08a5c4b497f19530b427744a22ce620efc3897d74aa1","width_pt":219.191},{"height_pt":34.095,"number":6,"path":"equation-06.svg","source":"R(\\tau\\mid c)=q_0(\\tau\\mid c)\\exp[-E(\\tau,c)],\\qquad E\\geq0,\\qquad 0<Z(c)=\\int R(\\tau\\mid c)d\\tau\\leq1.","source_sha256":"93e527af4224d6e4d59279a9d7779cd203fa4f8e30c96085f6803e84e7e212db","width_pt":355.88},{"height_pt":35.397,"number":7,"path":"equation-07.svg","source":"Z\\prod_{e\\in\\tau}P_F(e)=R(x)\\prod_{e\\in\\tau}P_B(e^{\\mathrm{rev}}).","source_sha256":"94082b3bb29e08493b94002239ff10e306154d7e94839c8a9dc545e394e16934","width_pt":152.891},{"height_pt":33.987,"number":8,"path":"equation-08.svg","source":"s_j(q)=\\frac{2q^\\top e_j-\\|e_j\\|_2^2}{\\tau}\n       =-\\frac{\\|q-e_j\\|_2^2}{\\tau}+\\frac{\\|q\\|_2^2}{\\tau}.","source_sha256":"513f536b6f1fe0ecbfd78b9a81661d6b9f727f68d5e1b303cd938f741667a977","width_pt":210.089},{"height_pt":38.417,"number":9,"path":"equation-09.svg","source":"P(Y=y\\mid c)=\\sum_T\\int_{\\{z:D(T,z,c)=y\\}}p(T\\mid c)q(z\\mid T,c)\\,dz.","source_sha256":"459948d3ccc07bfedcd5380a85826882f4b44edfac5bb1dbda9c1a279d7855af","width_pt":247.84},{"height_pt":21.724,"number":10,"path":"equation-10.svg","source":"\\mathcal L=\\lambda_{\\rm flow}\\mathcal L_{\\rm flow}\n +\\lambda_{\\rm tok}\\mathcal L_{\\rm tok}\n +\\lambda_{\\rm qual}\\mathcal L_{\\rm qual}\n +\\lambda_{\\rm ana}\\mathcal L_{\\rm ana}\n +\\lambda_{\\rm top}\\mathcal L_{\\rm top}.","source_sha256":"16c33f5f710c66bf8e08c06164baf10c2a6a71dce3a66743ed15a7763ba07047","width_pt":279.743},{"height_pt":23.026,"number":11,"path":"equation-11.svg","source":"G-F=\\partial_D H+H\\partial_C,\\qquad\n\\partial_C^2=0,\\quad\\partial_D^2=0.","source_sha256":"030aeba3b9dadfef98cc7ee3eca240b251c8599d53d6c29e8aa14c3822348f90","width_pt":210.45},{"height_pt":40.079,"number":12,"path":"equation-12.svg","source":"E_{\\rm rel}(z)=\\frac{1}{|E|d}\\sum_{(u,v)\\in E}\\|R_{uv}^{(u)}z_u-R_{uv}^{(v)}z_v\\|_2^2.","source_sha256":"a29db128067e3a439d097723eea417c825142a4c115f54339e9b0d63cf3cf394","width_pt":194.585},{"height_pt":22.278,"number":13,"path":"equation-13.svg","source":"f_{b,d}(t)=\\max\\{0,\\min(t-b,d-t)\\},\\qquad\n\\lambda_k(t)=k\\text{-th largest}\\{f_{b_i,d_i}(t)\\}_i.","source_sha256":"8fedb450015d5faabe87bcf64bbe6927b040921aa09c9eaee88a771f5bbeac8a","width_pt":319.123},{"height_pt":37.367,"number":14,"path":"equation-14.svg","source":"u_{j,\